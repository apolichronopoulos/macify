[pull]
	rebase = true
[merge]
	conflictstyle = diff3
[push]
	default = current
	autoSetupRemote = true
[user]
	name = Alexandros Polichronopoulos
	email = alexp.private@gmail.com
[core]
	editor = nano
	autocrlf = input
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[includeIf "gitdir:~/Projects/apo/*/"]
    path = ~/.gitconfig-apo
[fetch]
	prune = true
[init]
	defaultBranch = master
[tig]
	main-view-commit-title-graph = v1
[alias]
	f = fetch
	p = pull
	pr = pull --rebase
	fp = push --force
	main = "!git fetch && git rebase origin/main"
	master = "!git fetch && git rebase origin/master"
	autosquash = "!git rebase -i --autosquash origin/master"
	amend = "!git add . && git commit --amend --no-edit"
	fixup = "!git commit --all --amend --no-edit"
	https-to-ssh = "!f() { git remote set-url origin \"$(git remote get-url origin | sed -E \"s#https://github.com/(.+)#git@github.com:\\\\1#\")\"; }; f"
	switch-to-ssh = "!f() { git remote set-url origin \"$(git remote get-url origin | sed -E \"s#https://github.com/(.+)#git@github.com:\\\\1#\")\"; }; f"
	yolo = "!git commit -m \"$(curl --silent --fail https://whatthecommit.com/index.txt)\""
